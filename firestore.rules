rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { 
      return request.auth != null && (
        request.auth.token.email == 'mdmonirahamedarfin@gmail.com' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'director'])
      );
    }
    function isApproved() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true;
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidUser(data, userId) {
      // Identity: Either creating own profile, or an approved member/admin registering others
      return (data.get('uid', userId) == request.auth.uid || userId == request.auth.uid || isApproved() || isAdmin())
        && data.displayName is string && data.displayName.size() < 100
        && (data.get('email', null) == null || (data.email is string && data.email.size() < 100))
        && (data.get('houseName', null) == null || (data.houseName is string && data.houseName.size() < 200))
        && (data.get('village', null) == null || data.village is string)
        && (data.get('district', null) == null || data.district is string)
        && (data.get('nidNumber', null) == null || data.nidNumber is string)
        && (data.get('mobile', null) == null || data.mobile is string)
        && (data.get('fatherName', null) == null || data.fatherName is string)
        && (data.get('motherName', null) == null || data.motherName is string)
        && (data.get('fatherId', null) == null || data.fatherId is string)
        && (data.get('photoURL', null) == null || data.photoURL is string)
        && (data.get('bio', null) == null || data.bio is string)
        && (data.get('tags', null) == null || data.tags is list)
        && (data.get('createdAt', null) == null || data.createdAt == request.time)
        && (data.get('updatedAt', null) == null || data.updatedAt == request.time)
        && (data.role == 'member' || isAdmin())
        && (data.isApproved == false || isAdmin()); // Prevent self-approval or non-admin approving others
    }

    function isValidPost(data) {
      return data.authorId == request.auth.uid
        && data.content is string && data.content.size() < 10000
        && data.type in ['news', 'event', 'project', 'help']
        && data.createdAt == request.time
        && (data.get('authorName', null) == null || data.authorName is string)
        && (data.get('authorPhotoURL', null) == null || data.authorPhotoURL is string)
        && (data.get('audioUrl', null) == null || data.audioUrl is string)
        && (data.get('imageUrl', null) == null || data.imageUrl is string)
        && (data.get('blocks', null) == null || data.blocks is list)
        && (data.get('projectStartDate', null) == null || data.projectStartDate is string)
        && (data.get('projectEndDate', null) == null || data.projectEndDate is string)
        && (data.get('projectBudget', null) == null || data.projectBudget is number)
        && (data.get('projectSummary', null) == null || data.projectSummary is string)
        && (data.get('projectProgress', null) == null || (data.projectProgress is number && data.projectProgress >= 0 && data.projectProgress <= 100))
        && (data.get('projectStatusUpdate', null) == null || data.projectStatusUpdate is string)
        && (data.get('projectBudgetBreakdown', null) == null || data.projectBudgetBreakdown is list)
        && (data.get('likes', null) == null || data.likes is list)
        && (data.get('commentCount', null) == null || data.commentCount is number);
    }

    function isValidComment(data) {
      return data.authorId == request.auth.uid
        && data.content is string && data.content.size() < 2000
        && data.postId is string
        && data.createdAt == request.time
        && (data.get('parentId', null) == null || data.parentId is string)
        && (data.get('audioUrl', null) == null || data.audioUrl is string)
        && (data.get('authorName', null) == null || data.authorName is string)
        && (data.get('authorPhotoURL', null) == null || data.authorPhotoURL is string);
    }

    function isValidContribution(data) {
      return data.userId == request.auth.uid
        && data.amount is number && data.amount > 0
        && data.postId is string
        && data.method in ['bkash', 'nagad', 'bank', 'cash']
        && data.transactionId is string && data.transactionId.size() < 100
        && data.status == 'pending'
        && (data.get('isPublic', null) == null || data.isPublic is bool);
    }

    function isValidSubscription(data) {
      return data.amount is number && data.amount >= 0
        && data.month is string && data.year is number;
    }

    function isValidConversation(data) {
      return (data.get('participants', null) == null || (data.participants is list && data.participants.size() >= 2 && data.participants.hasAny([request.auth.uid])))
        && (data.get('updatedAt', null) == null || data.updatedAt == request.time);
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid
        && data.content is string && data.content.size() < 10000 
        && data.conversationId is string
        && data.createdAt == request.time;
    }

    function isValidCall(data) {
      return data.callerId == request.auth.uid
        && data.receiverId is string && data.receiverId.size() < 128
        && data.type in ['voice', 'video']
        && data.status in ['ringing', 'accepted', 'rejected', 'ended', 'missed']
        && (data.get('createdAt', null) == null || data.createdAt == request.time);
    }

    // --- Collections ---

    // Calls
    match /calls/{callId} {
      allow read: if isSignedIn() && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && isValidCall(incoming());
      allow update: if isSignedIn() && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Conversations
    match /conversations/{convId} {
      allow read: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && incoming().participants.hasAny([request.auth.uid]) && isValidConversation(incoming());
      allow update: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]) 
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt', 'participantDetails']) || isAdmin());
      allow delete: if isAdmin();
    }

    // Messages
    match /messages/{messageId} {
      allow read: if isSignedIn() && get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && isValidMessage(incoming()) && get(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.participants.hasAny([request.auth.uid]);
      allow update: if isSignedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidUser(incoming(), userId);
      allow update: if ((isOwner(userId) || (isSignedIn() && resource.data.get('uid', null) == request.auth.uid)) 
                        && isValidUser(incoming(), userId) 
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'fatherName', 'motherName', 'fatherId', 'houseName', 'houseSegment', 'familyHead', 'mobile', 'familyIncome', 'studentCount', 'publicExamineeCount', 'isPublicContribution', 'village', 'district', 'nidNumber', 'memberSlug', 'memberId', 'role', 'isApproved', 'updatedAt', 'bio', 'tags', 'uid']))
                    || (isApproved() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isApproved', 'updatedAt']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Posts
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if (isApproved() || isAdmin()) && isValidPost(incoming());
      allow update: if (isOwner(existing().authorId) && isValidPost(incoming())) 
                    || ((isApproved() || isAdmin()) && (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'commentCount'])))
                    || isAdmin();
      allow delete: if (isOwner(existing().authorId)) || isAdmin();
    }

    // Comments
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if (isApproved() || isAdmin()) && isValidComment(incoming());
      allow update: if isOwner(existing().authorId) || isAdmin();
      allow delete: if isOwner(existing().authorId) 
                    || isAdmin() 
                    || isOwner(get(/databases/$(database)/documents/posts/$(existing().postId)).data.authorId);
    }

    // Contributions
    match /contributions/{contribId} {
      allow read: if isApproved() || isAdmin();
      allow create: if isApproved() && isValidContribution(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // Allow users to trigger registration alerts
      allow update, delete: if isAdmin();
    }

    // Subscriptions
    match /subscriptions/{subId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid); // members report maybe? no, usually admin
      allow update, delete: if isAdmin();
    }
  }
}
